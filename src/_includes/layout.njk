<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{{ title }} - sickfunny</title>
    <meta name="description" content="{{ description }}">
    <link rel="canonical" href="https://sickfunny.co{{ page.url }}">
    {% if image %}
    <meta property="og:image" content="https://sickfunny.co{{ image | ogImage }}">
    <meta name="twitter:card" content="summary_large_image">
    {% endif %}
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><style>@media(prefers-color-scheme:dark)%7Btext%7Bfill:%23dedede%7D%7D</style><text x='32' y='46' font-family='Helvetica Neue,Arial,sans-serif' font-size='44' text-anchor='middle' fill='%23232323'>{{ icon or "×)" }}</text></svg>">
    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="alternate" type="application/atom+xml" href="/feed.xml" title="sickfunny">
    <style>{% include "../css/styles.css" %}</style>
  </head>
  <body>

    <header>
      <a href="/" class="title"><strong>sick</strong>funny &#215;&#41;</a>
      <a href="/feed.xml">rss.</a>
    </header>

    <main>
      {{ content | safe }}
    </main>
    
    <footer>
      log: build completed — 0 warnings, 0 errors<br>
      log: loaded in <span id="load-time"></span>
    </footer>

    <script>
      onload = () => {
        const [n] = performance.getEntriesByType('navigation');
        document.getElementById('load-time').textContent = `${Math.round(n?.domContentLoadedEventEnd)}ms`;
      };
      if (location.hostname === 'sickfunny.co') {
        new Image().src = 'https://sickfunny.goatcounter.com/count?' + new URLSearchParams({
          p: location.pathname, t: document.title, r: document.referrer,
          s: `${screen.width},${screen.height},${devicePixelRatio}`
        });
      }
    </script>
  </body>
</html>
